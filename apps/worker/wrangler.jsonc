{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcadelink-api",
  "account_id": "23bd231499318d1677ffbb1b9dd704ae",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "link.neri.moe",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arcadelink",
      "database_id": "8f2b923d-6732-48e1-8e29-830d3b86449a"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "1df12f4558674675928e056f3a03e9b5"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://link.neri.moe",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "EXTRA_ALLOWED_ORIGINS": "http://localhost:5173"
  }
}
