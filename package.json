{
  "name": "arcadelink",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @arcadelink/* dev",
    "build": "pnpm --recursive build",
    "deploy": "wrangler deploy --cwd apps/worker",
    "db:migrate": "wrangler d1 migrations apply arcadelink --remote --cwd apps/worker",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
